# Copy to .env.local for local development. Never commit real values.
# On your host (Vercel, Cloud Run, anywhere), set the same variables in its settings.

# --- Required ---------------------------------------------------------------------------------

# API token of an internal connection (Developer portal, app.notion.com/developers/connections)
# (Read content is all the site needs).
NOTION_TOKEN=

# Your blog database: paste its full URL, its id, or its data source id.
NOTION_DATA_SOURCE=

# Canonical origin of the site, no trailing slash. Used for canonicals, the sitemap, feeds and
# structured data. On Vercel it defaults to your production domain.
SITE_URL=http://localhost:3000

# --- Instant publishing (set one or both) -------------------------------------------------------

# Option 1, Notion plans with automations: the secret your database automation sends in the
# X-Webhook-Secret header. Generate a long random value, for example: openssl rand -hex 32
NOTION_AUTOMATION_SECRET=

# Option 2, connection webhooks (no automations needed): the verification token Notion sends
# when you create the webhook subscription. See docs/publishing.md for secure setup.
NOTION_WEBHOOK_VERIFICATION_TOKEN=

# Temporarily set to 1 to log the subscription verification token; remove after setup.
NOTION_WEBHOOK_SETUP=

# --- Optional -------------------------------------------------------------------------------------

# Key that signs image URLs. Defaults to NOTION_TOKEN; set it if you want to rotate the token
# without changing image URLs.
NOTION_IMAGE_KEY=

# "false" keeps search engines out, for staging. Default: indexable, except Vercel previews.
SITE_INDEXABLE=

# "1" shows the built-in demo content instead of Notion. `npm run dev` does it on its own
# while NOTION_TOKEN is empty.
NOTION_DEMO=
